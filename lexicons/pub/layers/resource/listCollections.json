{
  "lexicon": 1,
  "id": "pub.layers.resource.listCollections",
  "defs": {
    "main": {
      "type": "query",
      "description": "List resource collections.",
      "parameters": {
        "type": "params",
        "required": [
          "repo"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "format": "at-identifier",
            "description": "The repository (DID or handle) whose collection records to list."
          },
          "kind": {
            "type": "string",
            "description": "Filter to collections with this kind slug."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Maximum number of records to return in one page."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor from a previous response, to resume after the last returned record."
          },
          "languages": {
            "type": "array",
            "description": "Filter to records covering any of these BCP-47 language tags.",
            "items": {
              "type": "string",
              "maxLength": 32
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "records"
          ],
          "properties": {
            "cursor": {
              "type": "string",
              "description": "Opaque pagination cursor to pass to the next call, absent when no further pages remain."
            },
            "records": {
              "type": "array",
              "description": "The page of collection records returned.",
              "items": {
                "type": "ref",
                "ref": "#recordView"
              }
            }
          }
        }
      }
    },
    "recordView": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "value"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of this collection record."
        },
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "CID of this collection record's indexed revision."
        },
        "value": {
          "type": "ref",
          "ref": "pub.layers.resource.collection#main",
          "description": "The collection record value."
        }
      }
    }
  }
}
