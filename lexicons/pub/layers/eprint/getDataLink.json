{
  "lexicon": 1,
  "id": "pub.layers.eprint.getDataLink",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a single data link by its AT-URI.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "format": "at-uri", "description": "AT-URI of the data link record to fetch." }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid", "value"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri", "description": "AT-URI of the returned data link record." },
            "cid": { "type": "string", "format": "cid", "description": "CID of the returned data link record at this revision." },
            "value": { "type": "ref", "ref": "pub.layers.eprint.dataLink#main", "description": "The data link record value." }
          }
        }
      },
      "errors": [{ "name": "RecordNotFound" }]
    }
  }
}
