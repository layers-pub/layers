{
  "lexicon": 1,
  "id": "pub.layers.ontology.listOntologies",
  "defs": {
    "main": {
      "type": "query",
      "description": "List ontologies.",
      "parameters": {
        "type": "params",
        "required": ["repo"],
        "properties": {
          "repo": { "type": "string", "format": "at-identifier", "description": "Restrict to ontologies published by this repo." },
          "domain": { "type": "string", "description": "Restrict to ontologies in this domain slug (e.g., 'biomedical', 'legal')." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50, "description": "Maximum number of ontologies to return in one page." },
          "cursor": { "type": "string", "description": "Opaque pagination cursor to resume from a previous page." }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["records"],
          "properties": {
            "cursor": { "type": "string", "description": "Opaque pagination cursor to pass to the next call; absent when the last page has been reached." },
            "records": {
              "type": "array",
              "description": "The page of matching ontologies.",
              "items": { "type": "ref", "ref": "#recordView" }
            }
          }
        }
      }
    },
    "recordView": {
      "type": "object",
      "required": ["uri", "cid", "value"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri", "description": "AT-URI of the ontology." },
        "cid": { "type": "string", "format": "cid", "description": "CID of the ontology's current revision." },
        "value": { "type": "ref", "ref": "pub.layers.ontology.ontology#main", "description": "The ontology record itself." }
      }
    }
  }
}
