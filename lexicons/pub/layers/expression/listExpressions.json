{
  "lexicon": 1,
  "id": "pub.layers.expression.listExpressions",
  "defs": {
    "main": {
      "type": "query",
      "description": "List expressions in a repository.",
      "parameters": {
        "type": "params",
        "required": [
          "repo"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "format": "at-identifier",
            "description": "The repository (DID or handle) whose expressions to list."
          },
          "kind": {
            "type": "string",
            "maxLength": 128,
            "description": "expression kind slug to filter by (fallback when a kindUri filter is unavailable)."
          },
          "parentRef": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of a parent to filter to (direct children only)."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Maximum number of records to return in one page."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor from a previous response, to resume after the last returned record."
          },
          "languages": {
            "type": "array",
            "description": "Filter to records covering any of these BCP-47 language tags.",
            "items": {
              "type": "string",
              "maxLength": 32
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "records"
          ],
          "properties": {
            "cursor": {
              "type": "string",
              "description": "Opaque pagination cursor for the next page, absent when no further results remain."
            },
            "records": {
              "type": "array",
              "description": "The page of expression records returned.",
              "items": {
                "type": "ref",
                "ref": "#recordView"
              }
            }
          }
        }
      }
    },
    "recordView": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "value"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of this expression record."
        },
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "CID of this expression record at this revision."
        },
        "value": {
          "type": "ref",
          "ref": "pub.layers.expression.expression#main",
          "description": "The expression record value."
        }
      }
    }
  }
}
