{
  "lexicon": 1,
  "id": "pub.layers.corpus.listMemberships",
  "defs": {
    "main": {
      "type": "query",
      "description": "List memberships.",
      "parameters": {
        "type": "params",
        "required": ["corpusRef"],
        "properties": {
          "corpusRef": { "type": "string", "format": "at-uri", "description": "AT-URI of the corpus whose memberships to list." },
          "split": { "type": "string", "description": "Filter to memberships assigned to this split slug (e.g., train, dev, test)." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50, "description": "Maximum number of memberships to return in one page." },
          "cursor": { "type": "string", "description": "Opaque pagination cursor to resume from a previous page." }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["records"],
          "properties": {
            "cursor": { "type": "string", "description": "Opaque pagination cursor for the next page, absent when no further results remain." },
            "records": {
              "type": "array",
              "description": "The page of membership records returned.",
              "items": { "type": "ref", "ref": "#recordView" }
            }
          }
        }
      }
    },
    "recordView": {
      "type": "object",
      "required": ["uri", "cid", "value"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri", "description": "AT-URI of this membership record." },
        "cid": { "type": "string", "format": "cid", "description": "CID of this membership record at this revision." },
        "value": { "type": "ref", "ref": "pub.layers.corpus.membership#main", "description": "The membership record value." }
      }
    }
  }
}
