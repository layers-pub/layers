{
  "lexicon": 1,
  "id": "pub.layers.corpus.listCorpora",
  "defs": {
    "main": {
      "type": "query",
      "description": "List corpora.",
      "parameters": {
        "type": "params",
        "required": [
          "repo"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "format": "at-identifier",
            "description": "DID or handle of the repository whose corpora to list."
          },
          "domain": {
            "type": "string",
            "description": "Filter to corpora in this domain slug (e.g., news, biomedical, legal)."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Maximum number of corpora to return in one page."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor to resume from a previous page."
          },
          "languages": {
            "type": "array",
            "description": "Filter to records covering any of these BCP-47 language tags.",
            "items": {
              "type": "string",
              "maxLength": 32
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "records"
          ],
          "properties": {
            "cursor": {
              "type": "string",
              "description": "Opaque pagination cursor for the next page, absent when no further results remain."
            },
            "records": {
              "type": "array",
              "description": "The page of corpus records returned.",
              "items": {
                "type": "ref",
                "ref": "#recordView"
              }
            }
          }
        }
      }
    },
    "recordView": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "value"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of this corpus record."
        },
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "CID of this corpus record at this revision."
        },
        "value": {
          "type": "ref",
          "ref": "pub.layers.corpus.corpus#main",
          "description": "The corpus record value."
        }
      }
    }
  }
}
